# ================================================================
# REAL-TIME EVENT & TREND SPIKE DETECTION RADAR
# Environment Configuration
# ================================================================

# System Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Operational Filters
REGIONS=India,USA
SENSITIVITY_THRESHOLD=3.5       # Z-score burst trigger (Default: 3.5, lower=more sensitive, higher=stricter)
USER_AGENT_EMAIL=analyst@earlywarning.local  # Required by SEC.gov regulatory feed

# ================================================================
# AI VERIFICATION (OPTIONAL)
# If left blank, the system automatically runs the built-in 
# Zero-Key Mathematical & Pattern Rule Verifier ($0 / no key needed).
# Get a free key at: https://aistudio.google.com
# ================================================================
GEMINI_API_KEY=

# Local Ollama AI (Alternative to Gemini, 100% free offline)
USE_LOCAL_OLLAMA=false
OLLAMA_ENDPOINT=http://localhost:11434

# ================================================================
# OPTIONAL ALERTING (If you also want mobile push notifications)
# ================================================================
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook URL (from channel settings)
DISCORD_WEBHOOK_URL=
